# Copiá este archivo a .env y completá tu ticket.
# .env está en .gitignore: nunca se commitea.

# Ticket de ChileCompra. Si lo dejás vacío, se usa el ticket público de PRUEBA
# (rate-limit alto, solo para arrancar). Pedí el tuyo a api@chilecompra.cl.
LOVEO_CHILECOMPRA_TICKET=tu-ticket-aca

# --- Parámetros operativos (opcionales) ---
# LOVEO_DIAS_HACIA_ATRAS=3
# LOVEO_MAX_DETALLES=150
# LOVEO_DELAY=0.5
# LOVEO_BASE=puerto_montt
