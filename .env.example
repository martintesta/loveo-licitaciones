# Copiá este archivo a .env y completá lo que uses. .env está en .gitignore: nunca se commitea.
# No todo hace falta en todas las máquinas: la app (Render) y el worker (tu notebook) usan subsets.

# ============================================================ BASE (imprescindible)
# Postgres (Neon) en prod; si lo dejás vacío, se usa SQLite local (loveo.db).
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# ============================================================ DESCUBRIMIENTO (Capa A)
# Ticket propio de ChileCompra. Vacío = ticket público de PRUEBA (rate-limited, solo para arrancar).
LOVEO_CHILECOMPRA_TICKET=tu-ticket-aca

# ============================================================ IA (Capa C + cubicación + precios web)
ANTHROPIC_API_KEY=sk-ant-...
# LOVEO_MODEL=claude-haiku-4-5        # modelo barato para lectura masiva
# LOVEO_PRECIOS_WEB=1                 # 0 = no buscar precios por web (solo catálogo interno)

# ============================================================ AVISOS DE DEADLINE (email)
# Sin SMTP_HOST o sin LOVEO_ALERT_TO, notificar.py degrada a no-op (no manda nada).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=app-password             # app password, NO tu contraseña normal
# SMTP_FROM=tu-cuenta@gmail.com      # opcional, default = SMTP_USER
# LOVEO_ALERT_TO=valentina@loveo.cl, martin@loveo.cl
# LOVEO_DIAS_ALERTA=5                # umbral de días para avisar cierre/visita

# ============================================================ WORKER RESIDENCIAL (Capa B + C)
# LOVEO_WORKER_INTERVAL=120          # segundos entre pasadas del loop
# LOVEO_WORKER_CAPAC=1               # 0 = worker solo-descarga (sin análisis Capa C)
# LOVEO_WORKER_STALE_H=24            # horas sin procesar para marcar el worker como "mudo"

# ============================================================ OBSERVABILIDAD / OPERACIÓN
# SENTRY_DSN=https://...ingest.sentry.io/...   # opcional: reenvía errores a Sentry
# LOVEO_ENV=prod
# LOVEO_SEED_PASS=cambia-esto        # password de siembra de los usuarios (override del temporal)
# BACKUP_KEEP=14                     # backups a retener (scripts/backup_db.py)
